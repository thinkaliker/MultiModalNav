{
  "name": "multimodalnav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && concurrently -k -n web,api -c blue,magenta \"vite\" \"wrangler pages dev --port 8788\"",
    "build": "vite build",
    "preview": "vite build && wrangler pages dev --port 8788",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy": "vite build && wrangler pages deploy"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/geojson": "^7946.0.16",
    "concurrently": "^10.0.7",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
